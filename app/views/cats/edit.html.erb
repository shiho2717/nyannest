<h1>猫を編集</h1>

<%= form_with model: @cat, local: true do |f| %>
  <div>
    <%= f.label :name,"名前" %>
    <%= f.text_field :name %>
  </div>

  <div>
    <%= f.label :birthday,"誕生日" %>
    <%= f.date_field  :birthday %>
  </div>

  <div>
    <%= f.label :sex, "性別" %>
    <%= f.select :sex, [
      ["不明", "unknown"],
      ["オス", "male"],
      ["メス", "female"]
    ] %>
  </div>

  <div>
    <%= f.label :breed, "猫種" %>
    <%= f.text_field  :breed %>
  </div>

  <div>
    <%= f.label :pattern, "柄" %>
    <%= f.text_field  :pattern %>
  </div>

  <div>
    <%= f.label :photo, "プロフィール画像" %>
    <%= f.file_field :photo, accept: "image/*" %>
  </div>

  <div>
    <%= f.submit "更新" %>
  </div>
<% end %>